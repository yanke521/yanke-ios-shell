<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>言克</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.3</string>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ★ 这条是壳里「每次重进都白加载一遍」的根治（2026-08-17）。
	     WKWebView **默认根本不跑 Service Worker**——不是没注册上、也不是注册失败，
	     是整个 API 在非 app-bound 的 WKWebView 里就不提供。所以 index.html 里那句
	     navigator.serviceWorker.register('/sw.js') 在壳里从来没有生效过，
	     冷启动零缓存、每个静态文件都得重新走网络（PWA 那边有 SW 所以反而快，
	     见记忆 project-frontend-asset-caching-sw）。
	     开 SW 的唯一办法就是把 app 声明成 App-Bound：这里列域名 +
	     WebViewController 里设 limitsNavigationsToAppBoundDomains = true，两个缺一不可。
	     代价：从此壳只能导航到下面这些域（外链本来就 cancel 掉交系统了，不受影响），
	     且不能再对第三方域 evaluateJavaScript —— 我们没这需求。
	     ⚠ 域名不带 scheme、不带路径；上限 10 个。 -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>yanke521.xyz</string>
	</array>

	<!-- 竖屏锁定，跟 manifest.json 的 orientation:portrait 一致 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- 用代码里的 preferredStatusBarStyle 控制状态栏（跟着主题色走） -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- 没有 storyboard，纯代码起 window -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!-- 聊天里要发图/拍照：文件选择器的「拍照」「照片图库」两条路都得有说明，
	     漏了 iOS 会在用户点下去的瞬间直接崩 -->
	<key>NSCameraUsageDescription</key>
	<string>拍照发给克</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>从相册选图发给克</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>保存图片到相册</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>录语音发给克</string>

	<!-- 定位（2026-08-10）：只为让网页里的 navigator.geolocation 能用。
	     WKWebView 会把网页的定位请求转成 app 自己的定位请求，所以权限说明必须写在
	     壳这边——网页那侧无论怎么写都没用，缺了这条是**静默失败**（回调根本不触发，
	     不报错也不弹窗）。不需要任何 entitlement，共享企业证书也能用。
	     「不开 app 也上报位置」是另一回事，那要写原生 CoreLocation + 后台模式。 -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>把你此刻在哪告诉克</string>
</dict>
</plist>
